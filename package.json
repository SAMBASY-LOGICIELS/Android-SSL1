{
  "name": "samba-sy-logiciels",
  "version": "1.0.0",
  "description": "SAMBA SY LOGICIELS - La rénovation digitale",
  "author": "SAMBA SY LOGICIELS",
  "main": "electron/main.js",
  "scripts": {
    "setup": "node scripts/download-libs.js",
    "start": "electron .",
    "build:exe": "electron-builder --win nsis",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sambasy.ssl",
    "productName": "SAMBA SY LOGICIELS",
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}